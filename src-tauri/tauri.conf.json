{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "T3 DeskCat",
  "version": "0.1.0",
  "identifier": "io.github.b40609.t3-deskcat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420/pet.html",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "pet",
        "title": "T3 DeskCat",
        "url": "pet.html",
        "width": 64,
        "height": 64,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      },
      {
        "label": "panel",
        "title": "T3 DeskCat Panel",
        "url": "panel.html",
        "width": 376,
        "height": 620,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
