{
  "name": "t3-deskcat",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop pet & multi-account AI quota monitor for T3 Code (Claude, Antigravity, Codex)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "build:exe": "tauri build --no-bundle",
    "deploy:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-local.ps1",
    "shot": "node scripts/shot-panel.mjs",
    "web": "node server/index.mjs",
    "web:build": "npm run build && node server/index.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-autostart": "^2.2.0",
    "@tauri-apps/plugin-notification": "^2.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
